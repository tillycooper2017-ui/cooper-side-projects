---
import { SITE } from '../data/site';
import { url } from '../lib/url';

const roles = SITE.targetRoles;
const roleList = `${roles.slice(0, -1).join(', ')}, and ${roles[roles.length - 1]}`;
---
<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">Let's talk.</h2>
    <p class="lede">Open to {roleList} roles.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={`mailto:${SITE.email}`}>Email me</a>
      <a class="btn btn-secondary" href={SITE.linkedin} rel="me">LinkedIn</a>
      {SITE.resumePath && <a class="btn btn-secondary" href={url(SITE.resumePath)} download>Resume PDF</a>}
    </div>
  </div>
</section>
