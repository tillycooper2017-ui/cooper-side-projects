---
import { SITE } from '../data/site';
import { url } from '../lib/url';
---
<section class="hero section" aria-labelledby="hero-title">
  <div class="container">
    <p class="eyebrow">{SITE.eyebrow}</p>
    <h1 id="hero-title">{SITE.positioning}</h1>
    <p class="lede">{SITE.intro}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={url('#work')}>See my work</a>
      {SITE.resumePath && <a class="btn btn-secondary" href={url(SITE.resumePath)} download>Download resume</a>}
      <a class="btn btn-secondary" href={SITE.linkedin} rel="me">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 10vw, 6rem); }
  h1 { max-width: 20ch; }
  .lede { font-size: clamp(1.1rem, 2.5vw, 1.3rem); }
</style>
