---
import { SITE } from '../data/site';
import { url } from '../lib/url';
---
<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">Contact</h2>
    <p class="lede">Hiring for Marketing Ops, RevOps, or PMM? I'd like to hear about it.</p>
    <ul class="links">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
      {SITE.resumePath && <li><a href={url(SITE.resumePath)} download>Resume (PDF)</a></li>}
    </ul>
  </div>
</section>

<style>
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; font-weight: 600; }
</style>
