---
import { STATS } from '../data/site';
---
<section class="stats-band" aria-label="Results at a glance">
  <div class="container">
    <ul class="stats">
      {STATS.map((s) => (
        <li><strong>{s.metric}</strong><span>{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats-band { padding-bottom: clamp(2.5rem, 7vw, 4rem); }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 48rem) { .stats { grid-template-columns: repeat(4, 1fr); } }
  li { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  strong { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.1; color: var(--accent); }
  span { font-size: 0.95rem; color: var(--muted); line-height: 1.4; }
</style>
