---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Tools from '../components/Tools.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { SITE } from '../data/site';
import { getCaseStudies } from '../lib/case-studies';
import { graph, personNode, websiteNode, PERSON_ID, WEBSITE_ID } from '../lib/schema';
import { absoluteUrl } from '../lib/url';

const studies = await getCaseStudies();

const jsonLd = graph(personNode(), websiteNode(), {
  '@type': 'ProfilePage',
  '@id': `${absoluteUrl()}#profile`,
  url: absoluteUrl(),
  name: SITE.name,
  isPartOf: { '@id': WEBSITE_ID() },
  mainEntity: { '@id': PERSON_ID() },
});
---
<Base title={SITE.name} jsonLd={jsonLd}>
  <Hero />
  <Stats />

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="container">
      <h2 id="work-title">Case studies</h2>
      <p class="lede">Problem, what I did, and the result.</p>
      <ul class="card-grid list">
        {studies.map((entry) => <CaseStudyCard entry={entry} />)}
      </ul>
    </div>
  </section>

  <Tools />
  <Skills />
  <About />
  <Contact />
</Base>

<style>
  .list { margin-top: 1.5rem; }
</style>
