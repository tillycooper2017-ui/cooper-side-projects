---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props { entry: CollectionEntry<'case-studies'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, category, summary, cardResult, draft, writeup } = entry.data;
const href = url(`work/${entry.id}/`);
---
<li class:list={['card', { linked: writeup }]}>
  <article>
    <p class="eyebrow">
      {category}
      {draft && <span class="draft-badge">Draft</span>}
    </p>
    <Heading>{writeup ? <a href={href}>{title}</a> : title}</Heading>
    <p class="summary">{summary}</p>
    {cardResult && <p class="result">{cardResult}</p>}
    <p class="more">{writeup ? <span aria-hidden="true">Read case study →</span> : 'Full write-up coming soon'}</p>
  </article>
</li>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; position: relative; }
  .linked:focus-within, .linked:hover { border-color: var(--accent); }
  a { color: var(--text); text-decoration: none; }
  /* Whole card is clickable via the heading link. */
  a::after { content: ''; position: absolute; inset: 0; }
  a:hover { text-decoration: underline; }
  .summary { color: var(--muted); }
  .result { font-weight: 600; }
  .more { margin: 0; font-weight: 600; font-size: 0.95rem; color: var(--accent); }
  .card:not(.linked) .more { color: var(--muted); font-weight: 500; }
  .eyebrow { display: flex; gap: 0.5rem; align-items: center; }
</style>
