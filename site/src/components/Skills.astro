---
const groups = [
  {
    name: 'Marketing',
    items: ['Channel and partner marketing', 'Co-op programs', 'Product launches', 'Sales enablement', 'Webinars and trade shows', 'SEO and AEO'],
  },
  {
    name: 'Operations',
    items: ['CRM implementation', 'Lead and quote routing', 'Data hygiene', 'Marketing automation', 'KPI dashboards', 'AI workflows'],
  },
  {
    name: 'Platforms',
    items: ['Dynamics 365', 'Power Automate', 'Copilot Studio', 'Power BI', 'HubSpot', 'Claude', 'Replit', 'GA4', 'Search Console', 'SEMrush', 'WordPress', 'Canva'],
  },
];
---
<section id="toolkit" class="section" aria-labelledby="toolkit-title">
  <div class="container">
    <h2 id="toolkit-title">Toolkit</h2>
    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul class="tag-list">{g.items.map((item) => <li class="tag">{item}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups { display: grid; gap: 1.5rem; grid-template-columns: 1fr; margin-top: 1rem; }
  @media (min-width: 48rem) { .groups { grid-template-columns: repeat(3, 1fr); } }
  .tag { font-size: 0.9rem; padding: 0.2rem 0.7rem; }
</style>
