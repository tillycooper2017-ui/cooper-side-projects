---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <p>© {year} {SITE.name}. Built with Astro, hosted on GitHub Pages.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding-block: 2rem; color: var(--muted); font-size: 0.9rem; }
  p { margin: 0; }
</style>
